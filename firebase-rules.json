{
  "rules": {
    ".read": true,
    ".write": false,
    "super_admin": {
      ".read": true,
      ".write": true
    },
    "clinics": {
      "$clinicId": {
        ".read": true,
        ".write": true,
        "patients": {
          ".indexOn": [
            "info/nationalId",
            "info/phone"
          ]
        },
        "notifications": {
          ".indexOn": [
            "createdAt",
            "isRead"
          ]
        },
        "bookings": {
          ".indexOn": [
            "date",
            "doctorId",
            "status"
          ]
        },
        "completedBookings": {
          ".indexOn": [
            "date",
            "doctorId"
          ]
        },
        "audit_logs": {
          ".indexOn": [
            "timestamp",
            "actorId",
            "eventType"
          ]
        },
        "telemetry": {
          ".indexOn": [
            "timestamp"
          ]
        },
        "invoices": {
          "$invoiceId": {
            ".write": "newData.exists() || root.child('super_admin').child(auth.uid).exists()"
          }
        },
        "financial_transactions": {
          "$txId": {
            ".write": "newData.exists() || root.child('super_admin').child(auth.uid).exists()"
          }
        }
      }
    }
  }
}
