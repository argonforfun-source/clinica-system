{
  "rules": {

    /* ════════════════════════════════════════════════════════
     * ARGON MEDICAL OS — Firebase Security Rules v2.3 (SaaS Mode)
     * تم الدمج مع إصلاحات التوافقية (Client-Side Auth)
     * ════════════════════════════════════════════════════════ */

    "clinic_auth_map": {
      ".read":  false,
      ".write": false,
      "$uid": {
        /* إصلاح v2.3 للسوبر أدمن */
        ".read": "auth != null && (
          auth.uid === $uid ||
          root.child('clinic_auth_map/' + auth.uid).val() === '__SUPER__'
        )",
        ".write": "auth != null && (
          root.child('clinic_auth_map/' + auth.uid).val() === '__SUPER__' ||
          (auth.uid === $uid && !data.exists() && newData.val() !== '__SUPER__')
        )",
        ".validate": "newData.isString() && (
          root.child('clinic_auth_map/' + auth.uid).val() === '__SUPER__' ||
          (newData.val() !== '__SUPER__' && newData.val().length > 2)
        )"
      }
    },

    "clinic_auth_settings": {
      ".read":  false,
      ".write": false,
      "$clinicId": {
        ".read":  "auth != null && (root.child('clinic_auth_map/' + auth.uid).val() === '__SUPER__' || root.child('clinic_auth_map/' + auth.uid).val() === $clinicId)",
        ".write": "auth != null && (root.child('clinic_auth_map/' + auth.uid).val() === '__SUPER__' || (root.child('clinic_auth_map/' + auth.uid).val() === $clinicId && !data.exists()))",
        ".validate": "newData.hasChildren(['authEmail'])"
      }
    },

    "super_admin": {
      ".read":  "auth != null && root.child('clinic_auth_map/' + auth.uid).val() === '__SUPER__'",
      ".write": "auth != null && root.child('clinic_auth_map/' + auth.uid).val() === '__SUPER__'"
    },

    "clinics": {
      /* إصلاح v2.3: قراءة السوبر أدمن لقائمة العيادات */
      ".read": "auth != null && (
        auth.token.role === 'super' ||
        root.child('clinic_auth_map/' + auth.uid).val() === '__SUPER__'
      )",

      "$clinicId": {
        /* ── تم استعادة القراءة والكتابة المفتوحة ──
           لأن نظام (ArgonEnterpriseAuth) يعمل محلياً في المتصفح 
           ويعتبر غير مصادق من وجهة نظر Firebase */
        ".read": true,
        ".write": true,

        "settings": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 200"
          },
          "status": {
            ".validate": "newData.val() === 'active' || newData.val() === 'suspended' || newData.val() === 'maintenance'"
          }
        },

        "active_logins": {
          "$staffId": {
            ".validate": "newData.hasChildren(['sessionId'])"
          }
        },

        "patients": {
          ".indexOn": ["info/name", "info/phone", "info/nationalId", "info/mrn"],
          "$patientId": {
            ".validate": "newData.hasChildren(['info'])",
            "info": {
              ".validate": "newData.hasChildren(['name'])",
              "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 150" },
              "phone": { ".validate": "!newData.exists() || (newData.isString() && (newData.val().length === 0 || newData.val().length <= 20))" },
              "nationalId": { ".validate": "!newData.exists() || (newData.isString() && (newData.val().length === 0 || newData.val().length >= 9))" },
              "mrn": { ".validate": "!newData.exists() || newData.isString()" }
            },

            "visits": {
              "$visitId": {
                ".write": "!(data.exists() && data.child('status').val() === 'signed') && (
                  !data.exists() ||
                  (newData.exists() && !newData.child('status').exists()) ||
                  (newData.exists() && newData.child('status').val() === 'archived') ||
                  (newData.exists() && newData.child('status').val() === 'signed')
                )"
              }
            },
            "specialty_data": {
              "dental_history": {
                ".indexOn": ["toothCode", "procedureCode", "doctorId"],
                "$eventId": {
                  ".write": "!data.exists()",
                  ".validate": "newData.hasChildren(['patientId', 'procedureCode', 'doctorId', 'date']) && newData.child('patientId').val() === $patientId"
                }
              }
            }
          }
        },

        "bookings": {
          ".indexOn": ["date", "status", "doctorId", "patientId", "docKey"],
          "$bookingId": {
            ".validate": "newData.hasChildren(['patName', 'date'])"
          }
        },

        "completedBookings": {
          ".indexOn": ["date", "status", "doctorId", "patientId"],
          "$bookingId": {
            ".validate": "newData.hasChildren(['patName', 'date'])"
          }
        },
        
        "archived_bookings": {
          ".indexOn": ["date", "status", "doctorId", "patientId"]
        },

        "doctors": {
          "$doctorId": {
            ".validate": "newData.hasChildren(['name'])"
          }
        },

        "doctor_pricing": {
          "$doctorId": {
            "$serviceId": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },

        "lab_orders": {
          ".indexOn": ["patientId", "status", "createdAt"],
          "$orderId": {
            ".validate": "newData.hasChildren(['patientId', 'requestedTests'])"
          }
        },

        "radiology_orders": {
          ".indexOn": ["patientId", "status"],
          "$orderId": {
            ".validate": "newData.hasChildren(['patientId', 'requestedScans'])"
          }
        },

        "prescriptions": {
          ".indexOn": ["patientId", "status"],
          "$rxId": {
            ".validate": "newData.hasChildren(['patientId', 'medications'])"
          }
        },

        "invoices": {
          ".indexOn": ["patientId", "status", "createdAt"],
          "$invId": {
            ".validate": "newData.hasChildren(['patientId', 'total'])",
            ".write": "newData.exists()"
          }
        },
        
        "financial_transactions": {
          ".indexOn": ["patientId", "invoiceId", "timestamp"],
          "$txId": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['patientId', 'type', 'amount', 'timestamp']) && newData.child('amount').isNumber() && newData.child('amount').val() > 0 && (newData.child('type').val() === 'PAYMENT' || newData.child('type').val() === 'REVERSAL')"
          }
        },

        "audit_logs": {
          "$logId": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['action', 'timestamp']) && newData.child('action').isString() && newData.child('action').val().length >= 2 && newData.child('action').val().length <= 100"
          }
        },

        "active_sessions": {
          ".indexOn": ["doctorId"],
          "$patientId": {
            ".validate": "newData.hasChildren(['doctorId', 'lockedAt'])"
          }
        },

        "notifications": {
          ".indexOn": ["role", "docKey", "createdAt"]
        },

        "pharmacy_inventory": {
          ".indexOn": ["name", "barcode", "active"]
        },

        "billing_triggers": {
          ".indexOn": ["processingStatus", "createdAt"]
        },

        "referrals": {
          ".indexOn": ["status", "toDept"]
        },

        "identity_changes": {
          ".indexOn": ["status", "requestedAt"]
        },

        "tasks": {
          "$doctorId": {
            ".read":  true,
            ".write": true
          }
        },

        "departments": {
          ".indexOn": ["name"]
        },

        "pricing_catalog": {
          ".indexOn": ["type", "active", "name"]
        },

        "billing_sessions": {
          ".indexOn": ["status", "patientId"]
        },

        "specialty_data": {
          ".indexOn": ["specialty"]
        },
        "doctor_dental_labels": {
          "$doctorId": {
            "$labelType": {
              "$stableKey": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
              }
            }
          }
        },

        "slotLocks": {
          ".indexOn": ["date", "doctorId"]
        },

        "presence": {
          ".indexOn": ["updatedAt"]
        },

        "stats": {
          "visitors": { ".validate": "newData.isNumber()" },
          "totalBookings": { ".validate": "newData.isNumber()" }
        },

        "dailyCounters": {
          "$date": {
            ".validate": "newData.isNumber() || newData.hasChildren()"
          }
        }
      }
    },

    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
